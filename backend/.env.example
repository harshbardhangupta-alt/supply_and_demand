# Copy to .env and adjust. NEVER commit real secrets.

# --- App ---
SMC_APP_NAME=Institutional S&D Engine
SMC_ENVIRONMENT=development

# --- Database ---
SMC_DATABASE_URL=sqlite+aiosqlite:///./smc.db
SMC_SYNC_DATABASE_URL=sqlite:///./smc.db
# PostgreSQL (production) example:
# SMC_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/smc
# SMC_SYNC_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/smc

# --- Trading safety ---
SMC_LIVE_TRADING_ENABLED=false
SMC_PAPER_TRADING_ENABLED=true
SMC_DEFAULT_EQUITY=1000000

# --- Market data ---
SMC_MARKET_DATA_PROVIDER=synthetic
SMC_DATA_MAX_AGE_SECONDS=120

# --- Universe ---
SMC_NIFTY500_REFRESH_ON_START=false

# --- Auth (demo; replace in production) ---
SMC_JWT_SECRET=change-me-in-production
SMC_ADMIN_USERNAME=admin
SMC_ADMIN_PASSWORD=admin

# --- CORS ---
# SMC_CORS_ORIGINS=["http://localhost:3005"]

# --- Dhan (Indian market; leave blank to keep disabled) ---
# These are OPTIONAL env fallbacks. The recommended way is the in-app
# Connections page (Settings > Connections), which stores them in the DB and
# tracks the 24h access-token rotation.
SMC_DHAN_CLIENT_ID=
SMC_DHAN_ACCESS_TOKEN=

# --- OpenAI (optional; for research/analysis). Prefer the Connections page. ---
SMC_OPENAI_API_KEY=
SMC_OPENAI_MODEL=gpt-4o-mini

# --- MetaTrader 5 (forex/metals/commodities; Windows/bridge only) ---
SMC_MT5_LOGIN=
SMC_MT5_PASSWORD=
SMC_MT5_SERVER=
